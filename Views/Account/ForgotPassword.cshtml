@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "استعادة كلمة المرور";
}

<div class="auth-box">
    <h2>استعادة كلمة المرور 🔑</h2>
    <p class="subtitle" style="text-align:center; font-size:13px; margin-bottom:16px;">
        أدخل البريد الإلكتروني المسجل به الحساب لتوليد رمز التحقق.
    </p>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert-error">@Model.ErrorMessage</div>
    }

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div style="background:#e8f5e9; color:#2e7d32; padding:12px; border-radius:8px; margin-bottom:14px; font-size:13px;">
            <p style="margin:0 0 6px;">@Model.SuccessMessage</p>
            @if (!string.IsNullOrEmpty(Model.GeneratedResetCode))
            {
                <div style="background:#fff; padding:8px; border:2px dashed #4caf50; border-radius:6px; text-align:center; font-size:22px; font-weight:bold; letter-spacing:4px; margin:8px 0;">
                    @Model.GeneratedResetCode
                </div>
                <p style="font-size:11px; margin:0; color:#555;">انسخ رمز التحقق أعلاه واضغط على الزر التالي لتعيين كلمة المرور:</p>
                <div style="margin-top:10px;">
                    <a asp-controller="Account" asp-action="ResetPassword" asp-route-email="@Model.Email" asp-route-code="@Model.GeneratedResetCode" class="btn-primary" style="display:block; text-align:center; text-decoration:none;">
                        متابعة تعيين كلمة المرور ⬅️
                    </a>
                </div>
            }
        </div>
    }

    @if (string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <form asp-controller="Account" asp-action="ForgotPassword" method="post">
            <div asp-validation-summary="ModelOnly" class="alert-error"></div>

            <label asp-for="Email">البريد الإلكتروني (جيميل)</label>
            <input asp-for="Email" type="email" class="form-input" placeholder="example@gmail.com" autofocus required />
            <span asp-validation-for="Email" class="field-error"></span>

            <button type="submit" class="btn-primary">إرسال رمز التحقق</button>
        </form>
    }

    <p class="switch-link">
        تذكرت كلمة المرور؟ <a asp-controller="Account" asp-action="Login">تسجيل الدخول</a>
    </p>
</div>

@model RegisterViewModel
@{
    ViewData["Title"] = "حساب جديد";
}

<div class="auth-box">
    <h2>اعمل حساب جديد</h2>

    <form asp-controller="Account" asp-action="Register" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="All" class="alert-error"></div>

        <label asp-for="Username"></label>
        <input asp-for="Username" class="form-input" autofocus />

        <label asp-for="Email">البريد الإلكتروني (جيميل)</label>
        <input asp-for="Email" type="email" class="form-input" placeholder="example@gmail.com" />

        <label asp-for="Password"></label>
        <input asp-for="Password" type="password" class="form-input" />

        <label asp-for="ConfirmPassword"></label>
        <input asp-for="ConfirmPassword" type="password" class="form-input" />

        <label asp-for="SecretCode">كلمة السر الخاصة</label>
        <input asp-for="SecretCode" type="password" class="form-input" placeholder="كلمة السر الخاصة" />

        <label asp-for="ProfilePicture">صورة الملف الشخصي</label>
        <input asp-for="ProfilePicture" type="file" class="form-input" accept="image/*" />

        <button type="submit" class="btn-primary">تسجيل الحساب</button>
    </form>

    <p class="switch-link">
        عندك حساب؟ <a asp-controller="Account" asp-action="Login">سجل دخولك</a>
    </p>
</div>

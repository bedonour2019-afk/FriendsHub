@model ResetPasswordViewModel
@{
    ViewData["Title"] = "تعيين كلمة المرور الجديدة";
}

<div class="auth-box">
    <h2>تعيين كلمة مرور جديدة 🔒</h2>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert-error">@Model.ErrorMessage</div>
    }

    <form asp-controller="Account" asp-action="ResetPassword" method="post">
        <div asp-validation-summary="ModelOnly" class="alert-error"></div>

        <label asp-for="Email">البريد الإلكتروني</label>
        <input asp-for="Email" class="form-input" readonly />
        <span asp-validation-for="Email" class="field-error"></span>

        <label asp-for="ResetCode">رمز التحقق (المكون من 6 أرقام)</label>
        <input asp-for="ResetCode" class="form-input" placeholder="123456" autofocus required />
        <span asp-validation-for="ResetCode" class="field-error"></span>

        <label asp-for="NewPassword">كلمة المرور الجديدة</label>
        <input asp-for="NewPassword" type="password" class="form-input" required />
        <span asp-validation-for="NewPassword" class="field-error"></span>

        <label asp-for="ConfirmPassword">تأكيد كلمة المرور الجديدة</label>
        <input asp-for="ConfirmPassword" type="password" class="form-input" required />
        <span asp-validation-for="ConfirmPassword" class="field-error"></span>

        <button type="submit" class="btn-primary">حفظ كلمة المرور الجديدة</button>
    </form>

    <p class="switch-link">
        <a asp-controller="Account" asp-action="Login">رجوع لتسجيل الدخول</a>
    </p>
</div>

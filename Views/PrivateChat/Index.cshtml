@model List<FriendsHub.Models.PrivateChatListItemViewModel>
@{
    ViewData["Title"] = "الشات الخاص";
}

<div class="chat-wrapper">
    <div class="chat-header">
        <div>💬 المحادثات الخاصة</div>
    </div>

    <div class="chat-messages" style="padding: 16px;">
        @if (Model.Count == 0)
        {
            <div style="text-align: center; color: #a0a0a0; margin-top: 40px;">
                <p>مفيش محادثات خاصة</p>
                <p style="font-size: 12px;">ابدأ محادثة من قائمة المستخدمين الأونلاين</p>
            </div>
        }
        else
        {
            @foreach (var chat in Model)
            {
                <div class="chat-item" style="background: #30475e; padding: 12px; border-radius: 10px; margin-bottom: 10px; cursor: pointer; display: flex; align-items: center; gap: 12px;"
                     onclick="location.href='/PrivateChat/Chat/@chat.ChatId'">
                    <img src="@chat.ProfilePicture" alt="Avatar" style="width: 50px; height: 50px; border-radius: 50%; object-fit: cover; border: 2px solid #2575fc;" />
                    <div style="flex: 1;">
                        <div style="font-weight: bold; color: #e0e0e0;">@chat.OtherUser</div>
                        <div style="font-size: 12px; color: #a0a0a0; margin-top: 4px;">@chat.LastMessage</div>
                    </div>
                    <div style="text-align: left;">
                        <div style="font-size: 11px; color: #a0a0a0;">@chat.LastMessageTime</div>
                        @if (chat.UnreadCount > 0)
                        {
                            <div style="background: #2575fc; color: white; border-radius: 50%; width: 20px; height: 20px; display: flex; align-items: center; justify-content: center; font-size: 11px; margin-top: 4px;">@chat.UnreadCount</div>
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>
